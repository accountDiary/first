<!-- 여기서 부터 내가 한 부분! -->
<!--    게시글 조회 -->
    <!-- 게시글 등록 -->
    <insert id="insertPost" parameterType="PostDto">
        INSERT INTO posts (post_writer, post_date, post_modify, title, sub_title, content, view_cnt)
        VALUES ( #{post_writer}, #{post_date}, #{post_modify}, #{title}, #{sub_title}, #{content}, #{view_cnt})
    </insert>

    <!-- 게시글 수정 -->
    <update id="updatePost" parameterType="PostDto">
        UPDATE posts
        SET post_writer = #{post_writer}, post_modify = #{post_modify}, title = #{title}, sub_title = #{sub_title}, content = #{content}
        WHERE post_id = #{post_id}
    </update>

    <!-- 게시글 삭제 -->
    <delete id="deletePost" parameterType="int">
        DELETE FROM posts WHERE post_id = #{post_id}
    </delete>
</mapper>